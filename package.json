{
  "name": "dots-of-games",
  "version": "0.1.0",
  "description": "Pixel art as code: CC0 game sprites you can combine, resize and recolor in one line. Zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "dog": "scripts/dog.js"
  },
  "files": [
    "src",
    "scripts/dog.js",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "check": "node scripts/validate.js && node --test test/*.test.js",
    "dev": "python3 -m http.server 8080"
  },
  "keywords": [
    "pixel-art",
    "sprites",
    "gamedev",
    "game-assets",
    "cc0",
    "spritesheet",
    "palette",
    "recolor",
    "8-bit",
    "16x16"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
