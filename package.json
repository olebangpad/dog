{
  "name": "pixspell",
  "version": "0.1.0",
  "description": "Every asset for your 2D game, from code: 2.7M characters that walk and fight, 845 sprites, 545 glowing effects and 66 sounds, generated, recolored and resized in one line of JavaScript. CC0 art, zero dependencies.",
  "keywords": [
    "pixel-art",
    "sprites",
    "gamedev",
    "game-assets",
    "procedural-generation",
    "sound-effects",
    "sfx",
    "cc0",
    "spritesheet",
    "phaser",
    "godot",
    "recolor",
    "character-generator",
    "8-bit",
    "16x16",
    "ai-agents"
  ],
  "homepage": "https://olebangpad.github.io/pixspell/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olebangpad/pixspell.git"
  },
  "bugs": {
    "url": "https://github.com/olebangpad/pixspell/issues"
  },
  "author": "olebangpad",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "pixspell": "scripts/pixspell.js"
  },
  "sideEffects": false,
  "files": [
    "src",
    "scripts/pixspell.js",
    "scripts/mcp.js",
    "skills",
    "templates",
    "llms.txt",
    "LICENSE-ASSETS"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "check": "node scripts/validate.js && node --test test/*.test.js",
    "dev": "python3 -m http.server 8080",
    "promo": "node scripts/record-promo.cjs",
    "types": "npx -y -p typescript@5.6.3 tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --lib es2022,dom test/types/usage.ts",
    "bench": "node scripts/bench.js",
    "snapshots": "node scripts/snapshots.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
