{
  "name": "dots-of-games",
  "version": "0.1.0",
  "description": "Pixel art as code: CC0 game sprites you can combine, resize and recolor in one line, plus a 2.7M-combination character maker. Zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "dog": "scripts/dog.js"
  },
  "files": [
    "src",
    "scripts/dog.js",
    "assets",
    "skills",
    "templates",
    "llms.txt"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "check": "node scripts/validate.js && node --test test/*.test.js",
    "dev": "python3 -m http.server 8080",
    "promo": "node scripts/record-promo.cjs",
    "types": "npx -y -p typescript@5.6.3 tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --lib es2022,dom test/types/usage.ts",
    "bench": "node scripts/bench.js",
    "snapshots": "node scripts/snapshots.js"
  },
  "keywords": [
    "pixel-art",
    "sprites",
    "gamedev",
    "game-assets",
    "cc0",
    "spritesheet",
    "palette",
    "recolor",
    "8-bit",
    "16x16"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "types": "src/index.d.ts"
}
